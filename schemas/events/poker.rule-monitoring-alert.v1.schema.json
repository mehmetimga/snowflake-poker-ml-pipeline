{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poker.rule-monitoring-alert.v1",
  "title": "Rules v2 monitoring alert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "alert_id",
    "alert_type",
    "severity",
    "status",
    "tenant_id",
    "product_id",
    "dataset_id",
    "benchmark",
    "window_id",
    "window_start",
    "window_end",
    "label_cutoff_at",
    "evaluation_id",
    "baseline_payload_sha256",
    "rollout_id",
    "model_name",
    "model_run_id",
    "rule_id",
    "rule_version",
    "reason_codes",
    "observed",
    "thresholds",
    "recommended_action",
    "automatic_rule_disable",
    "enforcement_authority"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "alert_id": {"type": "string", "format": "uuid"},
    "alert_type": {"const": "rule_monitoring"},
    "severity": {"enum": ["warning", "critical"]},
    "status": {"const": "open"},
    "tenant_id": {"type": "string", "minLength": 1},
    "product_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "benchmark": {"type": "string", "minLength": 1},
    "window_id": {"type": "string", "minLength": 1},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "label_cutoff_at": {"type": "string", "format": "date-time"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "baseline_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rollout_id": {"type": "string", "minLength": 1},
    "model_name": {"type": "string", "minLength": 1},
    "model_run_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "rule_version": {"type": "integer", "minimum": 1},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "observed": {"type": "object"},
    "thresholds": {"type": "object"},
    "recommended_action": {"type": "string", "minLength": 1},
    "automatic_rule_disable": {"const": false},
    "enforcement_authority": {"const": false}
  }
}
