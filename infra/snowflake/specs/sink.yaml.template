spec:
  containers:
  - name: sink
    image: __SINK_IMAGE_PATH__
    command:
    - /usr/local/bin/sink-kafka
    args:
    - --metrics-listen
    - 0.0.0.0:9094
    env:
      SINK_SERVICE_BUILD_VERSION: __SINK_BUILD_VERSION__
      SINK_ALLOWED_TENANTS: "__SINK_ALLOWED_TENANTS__"
      SINK_FROM_BEGINNING: "true"
      SNOWFLAKE_EVENT_WRITER_URL: http://127.0.0.1:8091
      KAFKA_BOOTSTRAP_SERVERS: __KAFKA_BOOTSTRAP_SERVERS__
      KAFKA_SECURITY_PROTOCOL: SASL_SSL
      KAFKA_SASL_MECHANISM: PLAIN
      KAFKA_SNOWFLAKE_SINK_GROUP_ID: __SINK_GROUP_ID__
    secrets:
    - snowflakeSecret: POKER_ML_DEMO.SPCS.KAFKA_CREDENTIALS
      secretKeyRef: username
      envVarName: KAFKA_SASL_USERNAME
    - snowflakeSecret: POKER_ML_DEMO.SPCS.KAFKA_CREDENTIALS
      secretKeyRef: password
      envVarName: KAFKA_SASL_PASSWORD
    readinessProbe:
      port: 9094
      path: /healthz
    resources:
      requests:
        cpu: 0.25
        memory: 0.5Gi
      limits:
        cpu: 0.5
        memory: 1Gi
  - name: snowflake-writer
    image: __SINK_IMAGE_PATH__
    command:
    - /opt/snowflake-event-writer/venv/bin/python
    args:
    - /opt/snowflake-event-writer/server.py
    env:
      SNOWFLAKE_WAREHOUSE: DEMO_WH
      SNOWFLAKE_DATABASE: POKER_ML_DEMO
      SNOWFLAKE_SCHEMA: SPCS
      EVENT_WRITER_PORT: "8091"
      EVENT_WRITER_CONNECT_TIMEOUT_SECONDS: "15"
      EVENT_WRITER_QUERY_TIMEOUT_SECONDS: "30"
    readinessProbe:
      port: 8091
      path: /healthz
    resources:
      requests:
        cpu: 0.25
        memory: 0.5Gi
      limits:
        cpu: 0.5
        memory: 1Gi
  endpoints:
  - name: sink-metrics
    port: 9094
    protocol: HTTP
    public: false
  logExporters:
    eventTableConfig:
      logLevel: INFO
  platformMonitor:
    metricConfig:
      groups:
      - system
      - network
      - status
