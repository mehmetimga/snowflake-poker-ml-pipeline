{
  "name": "poker-hand-outbox-sim-v1",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres-cdc",
    "database.port": "5432",
    "database.user": "debezium",
    "database.password": "debezium",
    "database.dbname": "poker_sim",
    "topic.prefix": "poker.sim",
    "plugin.name": "pgoutput",
    "slot.name": "poker_sim_hand_outbox_v1",
    "publication.name": "poker_sim_hand_outbox_pub",
    "publication.autocreate.mode": "disabled",
    "schema.include.list": "public",
    "table.include.list": "public.hand_completed_outbox",
    "snapshot.mode": "initial",
    "snapshot.locking.mode": "shared",
    "binary.handling.mode": "base64",
    "include.schema.changes": "false",
    "provide.transaction.metadata": "true",
    "tombstones.on.delete": "false",
    "heartbeat.interval.ms": "10000",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "predicates": "isHandOutbox",
    "predicates.isHandOutbox.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.isHandOutbox.pattern": "poker\\.sim\\.public\\.hand_completed_outbox",
    "transforms": "routeHandOutbox",
    "transforms.routeHandOutbox.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeHandOutbox.predicate": "isHandOutbox",
    "transforms.routeHandOutbox.regex": "poker\\.sim\\.public\\.hand_completed_outbox",
    "transforms.routeHandOutbox.replacement": "poker.sim.cdc-hand-outbox.v1"
  }
}
