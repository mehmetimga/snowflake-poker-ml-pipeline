FROM python:3.11-slim@sha256:00af38ae2ed311628970782e8a2d7f014d8909dbc63cb97bc0a158187f4db045

ARG BUILD_VERSION=dev
LABEL org.opencontainers.image.title="poker-pipeline" \
      org.opencontainers.image.description="Retained legacy realtime rollback image; do not use for new roles" \
      org.opencontainers.image.revision="${BUILD_VERSION}"

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    ADMIN_BUILD_VERSION=${BUILD_VERSION}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt pyproject.toml ./
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --index-url https://download.pytorch.org/whl/cpu \
        torch==2.3.1 \
    && python -m pip install -r requirements.txt

COPY pipeline/ ./pipeline/
COPY admin/ ./admin/
COPY scripts/ ./scripts/
COPY sql/ ./sql/

RUN python -m pip install -e .
