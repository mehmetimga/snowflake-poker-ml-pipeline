# Default: run everything locally with DuckDB. No cloud account required.
WAREHOUSE_BACKEND=duckdb
DUCKDB_PATH=./data/parquet/warehouse.duckdb

# Optional: back DuckDB warehouse with S3 parquet (used on SageMaker/ECS).
# Each table is persisted to s3://${DUCKDB_S3_BUCKET}/${DUCKDB_S3_PREFIX}<table>.parquet.
# Credentials come from the AWS provider chain (env, profile, or instance role).
DUCKDB_S3_BUCKET=
DUCKDB_S3_PREFIX=warehouse/

# Snowflake (only needed when WAREHOUSE_BACKEND=snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# For human-user password authentication when Snowflake requires MFA:
# SNOWFLAKE_AUTHENTICATOR=username_password_mfa
# SNOWFLAKE_CLIENT_REQUEST_MFA_TOKEN=true
# Or use key-pair auth:
# SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=DEMO_WH
SNOWFLAKE_DATABASE=POKER_ML_DEMO
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=SYSADMIN

# Kafka (runs in docker compose by default)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Optional: all broker host:port values returned by managed Kafka metadata.
# Snowflake egress must allow these in addition to the bootstrap endpoint.
KAFKA_EGRESS_BROKERS=
# Recommended for POKER_ADAPTER_SIM: a dedicated Confluent principal whose
# ACLs allow read on poker.sim.cdc-hand-outbox.v1, write on the two simulation
# outputs, and read on only the adapter's simulation consumer group.
KAFKA_ADAPTER_SIM_SASL_USERNAME=
KAFKA_ADAPTER_SIM_SASL_PASSWORD=
KAFKA_HANDS_TOPIC=hands.raw
# Context-rich direct-publish topics. These are separate from the legacy demo
# topic above until downstream envelope consumers are enabled.
KAFKA_WORLD_HANDS_TOPIC=poker.hands.raw.v1
KAFKA_CDC_HAND_OUTBOX_TOPIC=cdc.poker.hand-outbox.v1
KAFKA_CDC_CANONICAL_HANDS_TOPIC=poker.hands.raw.v1
KAFKA_HAND_ADAPTER_GROUP_ID=poker-go-hand-adapter-v1
CDC_DATASET_ID=poker-live-v1
CDC_DATASET_SPLIT=live
CDC_EXPECTED_DATABASE=poker
CDC_EXPECTED_SCHEMA=public
CDC_EXPECTED_TABLE=hand_completed_outbox
CDC_ALLOWED_TENANTS=demo
CDC_ALLOWED_GAME_TYPES=NLH_CASH_6MAX,NLH_TOURNAMENT_6MAX
# The current repository supports only isolated synthetic CDC simulation. Use
# the go-hand-adapter-sim target or the POKER_ADAPTER_SIM spec, which override
# all three Kafka topics into the poker.sim.* namespace.
CDC_SIMULATION_MODE=false
CDC_ALLOW_SIMULATION_CODECS=false
KAFKA_USER_CONTEXT_TOPIC=poker.user-context.v1
KAFKA_SESSION_CONTEXT_TOPIC=poker.session-context.v1
KAFKA_ACCOUNT_LINKS_TOPIC=poker.account-links.v1
KAFKA_PLAYER_CONTEXT_TOPIC=poker.hand-player-context.v1
KAFKA_PAIR_FEATURES_TOPIC=poker.pair-features.v1
KAFKA_RISK_SCORES_TOPIC=poker.risk-scores.v1
KAFKA_RULE_EVIDENCE_TOPIC=poker.rule-evidence.v1
KAFKA_REVIEW_DECISIONS_TOPIC=poker.review-decisions.v1
KAFKA_RISK_ALERTS_TOPIC=poker.risk-alerts.v1
RISK_REVIEW_POLICY_PATH=../../schemas/policies/review-policy-v1.json
KAFKA_RISK_SCORER_GROUP_ID=poker-go-risk-scorer-v1
KAFKA_DEAD_LETTER_TOPIC=poker.pipeline.dead-letter.v1
KAFKA_ALERTS_TOPIC=alerts.out
KAFKA_PAIR_MEMORY_TOPIC=pair.memory
KAFKA_ACTION_PATTERNS_TOPIC=patterns.action
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Local PostgreSQL/Debezium simulation only; never reuse these credentials.
CDC_SIM_POSTGRES_DSN=postgresql://poker_sim:poker_sim@localhost:5433/poker_sim
# For AWS MSK Serverless, use:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=AWS_MSK_IAM

# Optional: path to a local Flink Kafka connector JAR if your PyFlink runtime
# does not bundle one. Pass it with scripts/flink_realtime.py --kafka-connector-jar.
FLINK_KAFKA_CONNECTOR_JAR=
# Optional: pin the Python executable used by PyFlink workers. Useful when the
# shell default Python is newer than the PyFlink dependency stack supports.
PYFLINK_PYTHON=

# Qdrant (runs in docker compose by default)
QDRANT_URL=http://localhost:6333
QDRANT_COLLUSION_COLLECTION=collusion_patterns
QDRANT_NORMAL_COLLECTION=normal_patterns

# Models output dir
MODELS_DIR=./models

# Random seed for reproducibility
RANDOM_SEED=42
