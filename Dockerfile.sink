# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.23.8
FROM golang:${GO_VERSION}-bookworm@sha256:0b4f8c5d414756a53ba0e4d235151f9b246552e512c3feaad5f9a3251376b279 AS build

WORKDIR /src
COPY services/go/go.mod services/go/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY services/go/ ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /out/sink-kafka ./cmd/sink-kafka

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

ARG BUILD_VERSION=dev
LABEL org.opencontainers.image.title="poker-sink" \
      org.opencontainers.image.description="Acknowledged Kafka-to-Snowflake event sink" \
      org.opencontainers.image.revision="${BUILD_VERSION}"

COPY streaming/snowflake-event-writer/requirements.txt /tmp/writer-requirements.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv \
    && python3 -m venv /opt/snowflake-event-writer/venv \
    && /opt/snowflake-event-writer/venv/bin/pip install --no-cache-dir \
      --requirement /tmp/writer-requirements.txt \
    && rm -rf /var/lib/apt/lists/* /tmp/writer-requirements.txt \
    && groupadd --system --gid 65532 poker \
    && useradd --system --uid 65532 --gid 65532 --no-create-home poker

COPY --from=build --chown=65532:65532 /out/sink-kafka /usr/local/bin/sink-kafka
COPY --chown=65532:65532 \
    streaming/snowflake-event-writer/server.py \
    /opt/snowflake-event-writer/server.py

RUN chmod 0755 /opt/snowflake-event-writer/server.py

USER 65532:65532
WORKDIR /opt/poker

ENV SINK_SERVICE_BUILD_VERSION=${BUILD_VERSION} \
    SINK_METRICS_LISTEN=0.0.0.0:9094 \
    SNOWFLAKE_EVENT_WRITER_URL=http://127.0.0.1:8091

EXPOSE 8091 9094
ENTRYPOINT ["/usr/local/bin/sink-kafka"]
